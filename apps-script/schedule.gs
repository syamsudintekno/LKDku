// Generated from src/domain/templateSchedule.js. Run node scripts/sync-domain.mjs.
// Pure domain functions. The Apps Script port is generated by scripts/sync-domain.mjs.
const TEMPLATE_DAY_MS = 86400000

function isIsoDate(value) {
  return (
    typeof value === 'string' &&
    /^\d{4}-\d{2}-\d{2}$/.test(value) &&
    !Number.isNaN(Date.parse(`${value}T00:00:00Z`)) &&
    new Date(`${value}T00:00:00Z`).toISOString().slice(0, 10) === value
  )
}

function validateTemplateSchedule(template) {
  const fail = (message) => {
    const error = new Error(message)
    error.code = 'VALIDATION'
    throw error
  }
  if (!template || !['mingguan', '2-mingguan', 'bulanan', 'sekali'].includes(template.frekuensi))
    fail('Pilih frekuensi yang tersedia.')
  if (
    !isIsoDate(template.tgl_mulai) ||
    !isIsoDate(template.tgl_akhir) ||
    template.tgl_mulai > template.tgl_akhir
  )
    fail('Rentang tanggal template tidak valid.')
  if (
    !['number', 'string'].includes(typeof template.hari) ||
    !Number.isInteger(Number(template.hari)) ||
    Number(template.hari) < 1 ||
    Number(template.hari) > 7
  )
    fail('Pilih hari Senin sampai Minggu.')
  const start = template.jam_mulai || ''
  const end = template.jam_selesai || ''
  if (
    (start || end) &&
    (!/^([01]\d|2[0-3]):[0-5]\d$/.test(start) ||
      !/^([01]\d|2[0-3]):[0-5]\d$/.test(end) ||
      start >= end)
  )
    fail('Isi kedua jam dengan jam selesai setelah jam mulai.')
  let excluded = template.pengecualian || []
  if (typeof excluded === 'string') {
    try {
      excluded = JSON.parse(excluded)
    } catch {
      fail('Daftar pengecualian harus berisi tanggal ISO.')
    }
  }
  if (
    !Array.isArray(excluded) ||
    excluded.some(
      (date) => !isIsoDate(date) || date < template.tgl_mulai || date > template.tgl_akhir,
    )
  )
    fail('Tanggal pengecualian harus berada dalam rentang template.')
  return {
    ...template,
    hari: Number(template.hari),
    jam_mulai: start,
    jam_selesai: end,
    pengecualian: [...new Set(excluded)].sort(),
  }
}

function previewTemplateDates(template, month, holidays = []) {
  const normalized = validateTemplateSchedule(template)
  if (typeof month !== 'string' || !/^\d{4}-(0[1-9]|1[0-2])$/.test(month)) {
    const error = new Error('Pilih bulan pratinjau yang valid.')
    error.code = 'VALIDATION'
    throw error
  }
  const dates = []
  const anchor = new Date(`${normalized.tgl_mulai}T00:00:00Z`)
  const anchorWeek = anchor.getTime() - ((anchor.getUTCDay() + 6) % 7) * TEMPLATE_DAY_MS
  const blocked = new Set(
    holidays.map((holiday) => (typeof holiday === 'string' ? holiday : holiday.tanggal)),
  )
  const excluded = new Set(normalized.pengecualian)
  const first = new Date(`${month}-01T00:00:00Z`)
  for (
    let cursor = first;
    cursor.toISOString().slice(0, 7) === month;
    cursor = new Date(cursor.getTime() + TEMPLATE_DAY_MS)
  ) {
    const iso = cursor.toISOString().slice(0, 10)
    const weekday = cursor.getUTCDay() || 7
    if (
      iso < normalized.tgl_mulai ||
      iso > normalized.tgl_akhir ||
      blocked.has(iso) ||
      excluded.has(iso)
    )
      continue
    // Sundays are skipped; Saturdays require an explicitly selected Saturday.
    if (weekday === 7 || (weekday === 6 && normalized.hari !== 6)) continue
    let matches
    if (normalized.frekuensi === 'sekali') matches = iso === normalized.tgl_mulai
    else if (normalized.frekuensi === 'bulanan')
      matches = cursor.getUTCDate() === anchor.getUTCDate()
    else
      matches =
        weekday === normalized.hari &&
        (normalized.frekuensi === 'mingguan' ||
          Math.floor((cursor.getTime() - anchorWeek) / (7 * TEMPLATE_DAY_MS)) % 2 === 0)
    if (matches) dates.push(iso)
  }
  return dates
}
